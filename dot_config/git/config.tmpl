[user]
	name = {{ .name }}
	email = {{ .email }}

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
	followTags = true
[pull]
	rebase = true
[fetch]
	prune = true
	pruneTags = true
[rebase]
	autoStash = true
	autoSquash = true

[merge]
	conflictStyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = zebra
	mnemonicPrefix = true
[rerere]
	enabled = true
	autoUpdate = true

[branch]
	sort = -committerdate
[column]
	ui = auto
[help]
	autocorrect = prompt
