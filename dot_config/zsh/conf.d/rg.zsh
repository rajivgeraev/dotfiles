command -v rg >/dev/null 2>&1 || return

# Внимание: это переменная окружения, её наследуют ВСЕ вызовы rg, включая те,
# что делают fzf, Zed и прочие обёртки. Поэтому в конфиге держим только то,
# что безопасно для чужих интеграций: ни --hidden, ни --no-ignore здесь быть
# не должно — они молча изменят результаты чужих поисков.
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgrep/config"
